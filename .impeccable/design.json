  "narrative": {
    "northStar": "Mulch's established local workspace",
    "overview": "Mulch inherits a warm neutral and olive identity: pale work surfaces, dark readable text, and restrained controls. The serif welcome and italic brand mark provide the established expressive detail; system sans-serif carries the operating interface.\n\nDepth comes mainly from surface tones and fine borders. Components remain compact, with open reading space around conversation text. This records the implemented workspace, without introducing a new metaphor, rebrand, or imagery. Directory disclosures organize saved conversations; the default inspector uses a compact execution tree with linked evidence. Confirmed history deletion uses the existing modal and danger treatments.",
    "keyCharacteristics": [
      "Warm neutral surfaces with one olive action accent.",
      "System interface text, serif welcome, monospace evidence.",
      "Fine borders, gently rounded controls, restrained elevation."
    ],
    "rules": [
      {
        "name": "The Text With Color Rule",
        "body": "Status and selection retain readable labels; color supplies reinforcement.",
        "section": "colors"
      },
      {
        "name": "The Structural Depth Rule",
        "body": "Elevation distinguishes floating controls and modal surfaces from the reading plane.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the inherited neutral and olive identity.",
      "Do use explicit text alongside color for status and selection.",
      "Do retain visible keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Don't introduce a new brand or decorative imagery into this workspace.",
      "Don't present missing evidence as a numeric zero.",
      "Don't turn context health or candidate selection into a correctness grade."
    ]
  }
